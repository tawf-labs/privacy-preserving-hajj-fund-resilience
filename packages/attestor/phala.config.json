{
  "name": "hajj-solvency-attestor",
  "version": "0.1.0",
  "description": "Layer 2 attestation enclave for ZK Hajj fund solvency verification (runs the prover inside the TEE)",
  "tee": true,
  "runtime": "nodejs",
  "entrypoint": "packages/attestor/src/server.ts",
  "env": {
    "NODE_ENV": "production",
    "PORT": "8787"
  },
  "resources": {
    "memory": "2Gi",
    "cpu": "2",
    "disk": "2Gi"
  },
  "scaling": {
    "min": 1,
    "max": 1,
    "target": "80"
  },
  "health": {
    "path": "/health",
    "interval": 30,
    "timeout": 5,
    "retries": 3
  },
  "secrets": ["ATTESTOR_SECRET_KEY"],
  "ports": [
    {
      "port": 8787,
      "protocol": "http",
      "public": true
    }
  ]
}
