{
  "name": "@hajj-zk/prover",
  "version": "0.1.0",
  "description": "Layer 3 driver: compiles the Noir solvency circuit, builds witnesses, and generates/verifies UltraHONK proofs with Barretenberg (bb.js). Also exports the Solidity verifier.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./encoding": "./src/encoding.ts"
  },
  "scripts": {
    "compile": "tsx src/cli/compile.ts",
    "prove": "tsx src/cli/prove.ts",
    "verify": "tsx src/cli/verify.ts",
    "fixtures": "tsx src/cli/fixtures.ts",
    "export-verifier": "tsx src/cli/export-verifier.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.0",
    "@hajj-zk/solvency-model": "workspace:*",
    "@noble/curves": "^2.0.0",
    "@noir-lang/noir_js": "1.0.0-rc.3",
    "@noir-lang/noir_wasm": "1.0.0-rc.3"
  },
  "license": "Apache-2.0"
}
