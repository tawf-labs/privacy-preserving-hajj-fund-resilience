{
  "name": "@hajj-zk/portal",
  "version": "0.1.0",
  "private": true,
  "description": "Layer 4: public verification portal. Lists solvency proofs, re-verifies them in the browser with Barretenberg and cross-checks the on-chain registry.",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "pnpm sync-data && vite",
